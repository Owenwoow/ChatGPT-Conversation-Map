{
  "manifest_version": 3,
  "name": "ChatGPT 对话地图",
  "version": "1.1.0",
  "description": "轻量对话小地图与 Markdown 层级目录，所有内容仅在本地处理。",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["src/adapter.js", "src/model.js", "src/content.js", "src/block-export.js"],
    "run_at": "document_idle"
  }],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "对话地图设置", "default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}
}
